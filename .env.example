# ---- мережа ----------------------------------------------------------------
# Підмережа внутрішньої мережі data; використовується в pg_hba.conf.
DATA_SUBNET=172.29.0.0/24
PGPROXY_IP=172.29.0.10
FRONT_IP=172.29.0.11

# ---- PostgreSQL ------------------------------------------------------------
# Кількість заздалегідь створених слотів tablespace (див. docs/02-decisions.md, ADR-007).
# Береться із запасом: слот порожній коштує один каталог.
OBSERVER_TS_SLOTS=150
# Квота на одну навчальну БД. 50 МБ — рішення від 2026-09-02.
OBSERVER_QUOTA_BYTES=52428800

# ---- порти назовні ---------------------------------------------------------
PGPROXY_PORT_PRIMARY=55432
PGPROXY_PORT_FALLBACK=8080

# ---- OIDC (Mix / doorkeeper-openid_connect), фаза 1 ------------------------
OIDC_ISSUER=https://mix.sumdu.edu.ua
OIDC_CLIENT_ID=
# Рівно ці два scope, за фактичною мапою claims Mix (docs/02-decisions.md, ADR-004):
#   openid  -> email, name, roles
#   profile -> sub
# `profile` потрібен ЛИШЕ заради `sub` — claim `full_name` ми не використовуємо,
# claim `name` достатньо. Scopes `email` і `roles` у Mix існують, але до них не
# привʼязаний жоден claim, тож запитувати їх немає сенсу.
OIDC_SCOPES=openid profile
# Бойове значення — https://observer.local/auth/callback (профіль server).
# Локальна розробка — caddy-dev на 8443 (`docker compose --profile dev up -d
# caddy-dev`, самопідписаний сертифікат): https://localhost:8443/auth/callback.
# У будь-якому разі має збігатися символ у символ із тим, що зареєстровано в Mix.
OIDC_REDIRECT_URI=https://observer.local/auth/callback

# Підписного ключа Mix тут НЕМАЄ і бути не повинно: Mix підписує HS256, тобто
# ключ перевірки = ключ підпису. Особу читаємо з /oauth/userinfo за access token,
# довіра — до TLS-каналу token endpoint. Див. ADR-012.
OIDC_USERINFO_ENDPOINT=https://mix.sumdu.edu.ua/oauth/userinfo

# Групи поки не ведемо: джерела даних немає (в claims Mix групи відсутні).
# Усі студенти отримують це значення. Коли група зʼявиться в /userinfo —
# заповнюємо з неї, а це лишається фолбеком.

# ---- front -----------------------------------------------------------------
# Хост, який студент вписує у psql/DBeaver. Це адреса pgproxy, не контейнера.
PUBLIC_DB_HOST=localhost
# Термін дії токена для psql/DBeaver.
DB_TOKEN_TTL_DAYS=180
# Локальний порт для розробки; назовні front публікується лише через caddy (фаза 4).
FRONT_DEV_PORT=8001

# Прапорець Secure на сесійній куці. Вимикати ЛИШЕ локально, поки немає TLS:
# з http браузер Secure-куку не зберігає і вхід просто не працює. На сервері — 1.
# З caddy-dev (профіль dev, https://localhost:8443) TLS локально вже є —
# лишай 1.
SESSION_COOKIE_SECURE=1

# Обмежувач входу до проксі. Ключ — РОЛЬ, а не адреса: група сидить за одним
# університетським NAT, і ліміт на IP замкнув би клас цілком. Захищає не токен
# (256 біт не підбирають), а чергу перевірок argon2: своє імʼя ролі знає кожен
# студент, і цикл із ним тримає всі слоти зайнятими.
PGPROXY_LOGIN_FAILS=10
PGPROXY_LOGIN_BLOCK_SEC=60

# ---- сервер (профіль `server`: docker compose --profile server up -d) -------
# Публічне імʼя, на яке Caddy візьме сертифікат. Має резолвитися в цю машину,
# і порт 80 назовні має бути відкритий — ACME ходить саме туди.
WEB_HOST=observer.sumdu.edu.ua
# Пошта для Let's Encrypt (попередження про закінчення строку).
ACME_EMAIL=
# Куди слати листи обслуговування (scripts/install-cron.sh).
OBSERVER_MAILTO=

# Вхід в обхід Mix — потрібен, поки LMS недоступна. НА СЕРВЕРІ МАЄ БУТИ 0.
# Кожен такий вхід пише подію dev_login у obs.db_events і показує банер.
DEV_LOGIN_ENABLED=0

# Явні endpoint-и мають пріоритет над .well-known. Порожні — беремо discovery.
OIDC_AUTHORIZE_ENDPOINT=
OIDC_TOKEN_ENDPOINT=

# ---- офсайт-бекап: wal-g у S3-сумісне сховище (ADR-022) --------------------
# ПОРОЖНІЙ WALG_S3_PREFIX = офсайту немає: entrypoint рендерить
# archive_mode = off, WAL переробляється як завжди, локальний дамп журналу
# (ADR-017) працює незалежно. Це типовий стан локального стенда.
#
# Щоб увімкнути на сервері, треба ТРИ речі, і кожної окремо недостатньо:
#   1) адреса сховища й бакет тут (бакет має існувати — wal-g його не створює);
#   2) ключі у файлах secrets/s3_access_key і secrets/s3_secret_key
#      (`make secrets` кладе туди випадкову пару для тесту — перезаписати);
#   3) OFFSITE_INTERNAL=false, інакше в контейнера кластера немає виходу в
#      мережу і wal-push падатиме на таймауті.
# Після зміни — `docker compose up -d postgres` (archive_mode вимагає
# перезапуску) і `make health`: там видно, чи архівування працює насправді.
#
# Приклади префікса (реальних ключів у цьому файлі бути не повинно):
#   s3://observer-backup/prod              — бакет + шлях
# AWS_ENDPOINT порожній = справжній AWS S3; для будь-якого іншого сховища
# (MinIO, Wasabi, Backblaze B2, Hetzner Object Storage) — його URL.
WALG_S3_PREFIX=
AWS_ENDPOINT=
AWS_REGION=us-east-1
AWS_S3_FORCE_PATH_STYLE=true
WALG_COMPRESSION_METHOD=lz4
WALG_UPLOAD_CONCURRENCY=2
WALG_DOWNLOAD_CONCURRENCY=2
# Вихід кластера в мережу. true (типово) — виходу немає взагалі; false —
# є, і лише до сховища бекапів має бути причина туди ходити.
OFFSITE_INTERNAL=true
