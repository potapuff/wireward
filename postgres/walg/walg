#!/bin/sh
# =============================================================================
# Обгортка над wal-g: підставляє ключі доступу і ключ шифрування з docker
# secrets, параметри з'єднання, далі передає аргументи як є.
#
# Ключі НЕ передаються через environment контейнера навмисно: змінні видно в
# `docker inspect`, у `/proc/PID/environ` будь-якого процесу того ж uid і в
# аварійному дампі. Файли секретів читаються рівно в момент виклику.
#
# Порожній WALG_S3_PREFIX — це не помилка конфігурації, а «офсайт-бекап не
# налаштований» (типовий стан локального стенда). Код виходу 3 відрізняє його
# від справжнього збою wal-g, який має свої коди.
# =============================================================================
set -eu

if [ -z "${WALG_S3_PREFIX:-}" ]; then
    echo "walg: WALG_S3_PREFIX порожній — офсайт-бекап (ADR-022) не налаштований" >&2
    exit 3
fi

for f in /run/secrets/s3_access_key /run/secrets/s3_secret_key; do
    [ -r "$f" ] || { echo "walg: немає доступу до $f" >&2; exit 3; }
    [ -s "$f" ] || { echo "walg: $f порожній — ключі S3 не заповнені" >&2; exit 3; }
done

AWS_ACCESS_KEY_ID="$(cat /run/secrets/s3_access_key)"
AWS_SECRET_ACCESS_KEY="$(cat /run/secrets/s3_secret_key)"
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY

# Шифрування копій (libsodium). S3-ключі закривають доступ до сховища, цей —
# вміст: у бакеті лежить фізична копія всього кластера, тобто журнал усіх
# запитів усіх студентів разом із їхніми базами, і сховище це чуже.
#
# Передається ШЛЯХОМ (WALG_LIBSODIUM_KEY_PATH), а не значенням
# (WALG_LIBSODIUM_KEY), з тієї ж причини, що й S3-ключі: значення видно в
# `docker inspect` і в оточенні процесу, шлях — ні.
#
# Відсутність ключа — ВІДМОВА, а не «шифруємо без нього». Мовчазний перехід на
# нешифровану копію дав би архів, у якому частина копій захищена, а частина ні,
# і різницю було б видно лише в день відновлення.
#
# Розшифрувати можна лише тим самим ключем: втратити його = втратити всі копії.
# Тому він і має лежати ще десь, крім цієї машини (docs/10-deploy.md §6б).
KEYF=/run/secrets/walg_libsodium_key
if [ ! -s "$KEYF" ]; then
    echo "walg: немає $KEYF — офсайт-копія була б незашифрованою (ADR-022)" >&2
    echo "walg: \`make secrets\` створює ключ; збережіть його копію ПОЗА сервером" >&2
    exit 3
fi
WALG_LIBSODIUM_KEY_PATH="$KEYF"
export WALG_LIBSODIUM_KEY_PATH

# backup-push ходить у кластер по libpq. Сокет, а не TCP: у pg_hba.conf
# рядок `local all postgres trust` уже є, а мережевого доступу до кластера
# немає ні в кого, крім проксі й front.
export PGHOST="${PGHOST:-/var/run/postgresql}"
export PGUSER="${PGUSER:-postgres}"

exec /usr/local/bin/wal-g "$@"
